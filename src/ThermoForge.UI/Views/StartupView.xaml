<UserControl x:Class="ThermoForge.UI.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ThermoForge.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}">

    <UserControl.Resources>
        <!-- Details pane for the selected entry. -->
        <DataTemplate DataType="{x:Type vm:StartupRowViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                    <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StateText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Visibility="{Binding Description.Length, Converter={StaticResource ToVisibility}}" />
                <Border Background="{StaticResource StatusWarmBrush}" CornerRadius="4" Padding="6,1" Margin="0,6,0,0"
                        HorizontalAlignment="Left" Visibility="{Binding IsNew, Converter={StaticResource ToVisibility}}">
                    <TextBlock Text="{Binding FirstSeenText}" Foreground="#111418" FontWeight="SemiBold" FontSize="12" />
                </Border>
                <TextBlock Text="{Binding SignatureText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RiskText}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />

                <TextBlock Text="FINDINGS" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="No suspicious traits found." Style="{StaticResource SecondaryText}"
                           Visibility="{Binding HasFindings, Converter={StaticResource ToVisibility}, ConverterParameter=Invert}" />
                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="3,0,0,0" Padding="10,4,0,4" Margin="0,0,0,8"
                                    BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                        <Run Text="{Binding Severity, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="COMMAND" Style="{StaticResource SectionLabel}" />
                <TextBox Text="{Binding CommandText, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="FILE" Style="{StaticResource SectionLabel}" />
                <TextBox Text="{Binding PathText, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" />

                <TextBlock Text="WHERE IT IS SET" Style="{StaticResource SectionLabel}" />
                <TextBox Text="{Binding Location, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Rescan" Style="{StaticResource ActionButton}" Margin="12,0,0,0"
                    Command="{Binding RescanCommand}" />
            <Grid Width="320">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Search name, command or publisher…" Margin="10,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Style="{StaticResource SecondaryText}"
                           Visibility="{Binding Text.Length, ElementName=SearchBox, Converter={StaticResource ToVisibility}, ConverterParameter=Invert}" />
            </Grid>
            <CheckBox Content="Only flagged" IsChecked="{Binding ShowFlaggedOnly}" Margin="16,0,0,0" />
            <CheckBox Content="Hide clean Microsoft entries" IsChecked="{Binding HideMicrosoft}" Margin="16,0,0,0" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                       Margin="16,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Entry list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid Style="{StaticResource DarkDataGrid}" IsReadOnly="True"
                          ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Risk" Width="110" SortMemberPath="Risk">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding SeverityText.Length, Converter={StaticResource ToVisibility}}">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Text="{Binding SeverityText}"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Name" Width="1.4*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource StatusWarmBrush}" CornerRadius="3" Padding="4,0" Margin="0,0,6,0"
                                                VerticalAlignment="Center" Visibility="{Binding IsNew, Converter={StaticResource ToVisibility}}">
                                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="#111418" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="130" />
                        <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="60" />
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.2*" />
                        <DataGridTextColumn Header="Findings" Binding="{Binding FindingsSummary}" Width="1.6*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="{Binding SelectedEntry.ToggleText, FallbackValue=Turn off}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding ToggleEnabledCommand}"
                                ToolTip="Stop or allow this entry starting automatically. Nothing is deleted." />
                        <Button Content="Open file location" Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding OpenFileLocationCommand}" />
                        <Button Content="Copy command" Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding CopyCommandCommand}" />
                        <Button Content="Search online" Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding SearchOnlineCommand}" />
                        <Button Content="{Binding SelectedEntry.TrustButtonText, FallbackValue=Trust this program}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding ToggleTrustCommand}" />
                    </WrapPanel>
                    <Grid>
                        <TextBlock Text="Select an entry to see what it runs, who signed it and where Windows keeps it."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Visibility="{Binding SelectedEntry, Converter={StaticResource ToVisibility}, ConverterParameter=Invert}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ContentControl Content="{Binding SelectedEntry}" />
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
