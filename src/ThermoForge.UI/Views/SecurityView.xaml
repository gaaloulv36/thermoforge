<UserControl x:Class="ThermoForge.UI.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ThermoForge.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SecurityViewModel}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Defender, its history, and files checked so far -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Refresh" Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                Command="{Binding RefreshDefenderCommand}" />
                        <Button Content="Open Windows Security" Style="{StaticResource ActionButton}"
                                Command="{Binding OpenWindowsSecurityCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Microsoft Defender" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DefenderMode}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding RealTimeText}" Style="{StaticResource SecondaryText}"
                                   Visibility="{Binding RealTimeText.Length, Converter={StaticResource ToVisibility}}" />
                        <TextBlock Text="{Binding SignaturesText}" Style="{StaticResource SecondaryText}"
                                   Visibility="{Binding SignaturesText.Length, Converter={StaticResource ToVisibility}}" />
                        <TextBlock Text="{Binding ProblemText}" Foreground="{StaticResource StatusHotBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding ProblemText.Length, Converter={StaticResource ToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Detection history" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DetectionsText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Detections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Bar" BorderThickness="3,0,0,0" Padding="10,4,0,4" Margin="0,0,0,8"
                                            BorderBrush="{StaticResource TextSecondaryBrush}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource SecondaryText}" />
                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <Run Text="{Binding Threat, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                                                <Run Text="Severity: " /><Run Text="{Binding Severity, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Where}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUnresolved}" Value="True">
                                            <Setter TargetName="Bar" Property="BorderBrush" Value="{StaticResource StatusHotBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Files checked" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Text="Results stay attached to the exact file: if it changes, it has to be checked again. Detections count toward the risk score." />
                    </StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Visibility="{Binding FileChecks.Count, Converter={StaticResource ToVisibility}, ConverterParameter=Invert}"
                                   Text="Nothing checked yet. Select a process or startup entry and choose &quot;Check on VirusTotal&quot; or &quot;Scan with Defender&quot;." />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FileChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Bar" BorderThickness="3,0,0,0" Padding="10,4,0,4" Margin="0,0,0,8"
                                                BorderBrush="{StaticResource StatusNormalBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDetected}" Value="True">
                                                <Setter TargetName="Bar" Property="BorderBrush" Value="{StaticResource StatusHotBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- VirusTotal and reports -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="VirusTotal" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Checks a file against 70+ antivirus engines. Only its SHA-256 fingerprint is sent, never the file, and only when you ask." />
                    <TextBlock Text="{Binding KeyStatusText}" TextWrapping="Wrap" Margin="0,10,0,6" />
                    <PasswordBox x:Name="KeyBox" Height="32" Padding="8,0" VerticalContentAlignment="Center"
                                 Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                                 AutomationProperties.Name="VirusTotal API key" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Save key" Style="{StaticResource ActionButton}" Margin="0,0,8,8" Click="OnSaveKey" />
                        <Button Content="Remove key" Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding RemoveKeyCommand}" />
                        <Button Content="Get a free key" Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding OpenVirusTotalSignupCommand}" />
                    </WrapPanel>

                    <TextBlock Text="CHECK EVERYTHING FLAGGED" Style="{StaticResource SectionLabel}" />
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Text="Looks up flagged programs and startup files not checked in the last week (up to 25), one every 15 seconds to stay within the free limit." />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Check flagged files" Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding CheckFlaggedCommand}" />
                        <Button Content="Cancel" Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding CancelCheckCommand}"
                                Visibility="{Binding IsBatchRunning, Converter={StaticResource ToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding BatchStatus}" TextWrapping="Wrap"
                               Visibility="{Binding BatchStatus.Length, Converter={StaticResource ToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Report" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="A snapshot of this PC: verdict, flagged processes, startup entries and connections, temperatures, Defender status, file checks and recent alerts. The HTML version opens in any browser and prints cleanly." />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Export HTML report" Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding ExportHtmlCommand}" />
                        <Button Content="Export JSON" Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                Command="{Binding ExportJsonCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Visibility="{Binding ExportStatus.Length, Converter={StaticResource ToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
