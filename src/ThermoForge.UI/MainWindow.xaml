<Window x:Class="ThermoForge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ThermoForge.UI.ViewModels"
        xmlns:views="clr-namespace:ThermoForge.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ThermoForge" Icon="Assets/ThermoForge.ico" Height="900" Width="1360" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/ThermoForge.png" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock FontSize="22" VerticalAlignment="Center">
                    <Run Text="Thermo" FontWeight="Medium" /><Run Text="Forge" FontWeight="Bold" Foreground="#E8463A" />
                </TextBlock>
                <TextBlock Text="by Forge Studio" Style="{StaticResource SecondaryText}" Margin="10,0,0,2" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock Text="Hardware temperatures, suspicious background activity and network connections" Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <!-- Warnings -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource CardBorder}" Background="{StaticResource WarningBackgroundBrush}"
                    BorderBrush="{StaticResource StatusWarmBrush}" Margin="0,0,0,8"
                    Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart as administrator"
                            Style="{StaticResource BannerButton}" Command="{Binding RestartAsAdministratorCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Not running as administrator. CPU, motherboard and fan sensors are unavailable (showing ACPI thermal zones instead), and Windows hides the file and command line of system and elevated processes." />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Background="{StaticResource WarningBackgroundBrush}"
                    BorderBrush="{StaticResource StatusWarmBrush}" Margin="0,0,0,8"
                    Visibility="{Binding ShowPawnIoWarning, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Get PawnIO"
                            Style="{StaticResource BannerButton}" Command="{Binding OpenPawnIoDownloadCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="The PawnIO driver is not installed. It is required to read CPU core/package temperatures. Install it (or run: winget install namazso.PawnIO), then restart the app." />
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="0,6,0,0" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Hardware">
                <views:HardwareView DataContext="{Binding Hardware}" />
            </TabItem>
            <TabItem AutomationProperties.Name="Processes">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Processes" />
                        <Border Background="{StaticResource StatusHotBrush}" CornerRadius="9" MinWidth="18" Height="18"
                                Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="Processes with a Medium or High finding"
                                Visibility="{Binding Processes.AlertCount, Converter={StaticResource ToVisibility}}">
                            <TextBlock Text="{Binding Processes.AlertCount}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:ProcessesView DataContext="{Binding Processes}" />
            </TabItem>
            <TabItem AutomationProperties.Name="Network">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Network" />
                        <Border Background="{StaticResource StatusHotBrush}" CornerRadius="9" MinWidth="18" Height="18"
                                Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="Programs with a Medium or High network finding"
                                Visibility="{Binding Network.AlertCount, Converter={StaticResource ToVisibility}}">
                            <TextBlock Text="{Binding Network.AlertCount}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:NetworkView DataContext="{Binding Network}" />
            </TabItem>
            <TabItem AutomationProperties.Name="Startup">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Startup" />
                        <Border Background="{StaticResource StatusHotBrush}" CornerRadius="9" MinWidth="18" Height="18"
                                Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="Startup entries with a Medium or High finding"
                                Visibility="{Binding Startup.AlertCount, Converter={StaticResource ToVisibility}}">
                            <TextBlock Text="{Binding Startup.AlertCount}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:StartupView DataContext="{Binding Startup}" />
            </TabItem>
            <TabItem Header="Alerts">
                <views:AlertsView DataContext="{Binding Alerts}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
