<Window x:Class="ThermoForge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ThermoForge.UI.ViewModels"
        xmlns:views="clr-namespace:ThermoForge.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ThermoForge" Icon="Assets/ThermoForge.ico" Height="900" Width="1360" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource SansFont}" FontSize="13">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: product mark, name and studio, like the website's product page. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource SuccessSoftBrush}"
                    BorderBrush="#1F5C47" Padding="10,3" VerticalAlignment="Center"
                    ToolTip="All checks run on this PC. Nothing is uploaded unless you ask (VirusTotal, updates).">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource StatusNormalBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Runs locally" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource StatusNormalBrush}" />
                </StackPanel>
            </Border>
            <Image Source="Assets/ThermoForge.png" Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}">
                    <Run Text="OPEN FORGE STUDIO" Foreground="{StaticResource AccentTextBrush}" /><Run Text="  /  TEMPS · PROCESSES · NETWORK" />
                </TextBlock>
                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0">
                    <Run Text="Thermo" /><Run Text="Forge" Foreground="{StaticResource AccentTextBrush}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Update and warnings -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource CardBorder}" Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="{StaticResource AccentBrush}" Margin="0,0,0,10"
                    Visibility="{Binding Update.ShowBanner, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Update now" Style="{StaticResource BannerButton}" Margin="0,0,8,0"
                                Command="{Binding Update.InstallCommand}" />
                        <Button Content="What's new" Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                Command="{Binding Update.OpenReleaseNotesCommand}" />
                        <Button Content="Skip this version" Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                Command="{Binding Update.SkipVersionCommand}" />
                        <Button Content="Later" Style="{StaticResource ActionButton}"
                                Command="{Binding Update.HideBannerCommand}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Update.AvailableText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Update.StatusText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Visibility="{Binding Update.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100" Value="{Binding Update.Progress}"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceAltBrush}" BorderThickness="0"
                                     Visibility="{Binding Update.IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Background="{StaticResource WarnSoftBrush}"
                    BorderBrush="{StaticResource WarnBorderBrush}" Margin="0,0,0,10"
                    Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart as administrator"
                            Style="{StaticResource ActionButton}" Margin="12,0,0,0" Command="{Binding RestartAsAdministratorCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Not running as administrator. CPU, motherboard and fan sensors are unavailable (showing ACPI thermal zones instead), and Windows hides the file and command line of system and elevated processes." />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Background="{StaticResource WarnSoftBrush}"
                    BorderBrush="{StaticResource WarnBorderBrush}" Margin="0,0,0,10"
                    Visibility="{Binding ShowPawnIoWarning, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Get PawnIO"
                            Style="{StaticResource ActionButton}" Margin="12,0,0,0" Command="{Binding OpenPawnIoDownloadCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="The PawnIO driver is not installed. It is required to read CPU core/package temperatures. Install it (or run: winget install namazso.PawnIO), then restart the app." />
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="0,6,0,0" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Hardware">
                <views:HardwareView DataContext="{Binding Hardware}" />
            </TabItem>
            <TabItem AutomationProperties.Name="Processes">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" TextElement.FontFamily="{StaticResource MonoFont}"
                                TextElement.FontSize="13" TextElement.FontWeight="Medium">
                        <TextBlock Text="Processes" />
                        <Border Style="{StaticResource Pill}" Background="{StaticResource DangerSoftBrush}"
                                BorderBrush="{StaticResource DangerBorderBrush}" Margin="8,0,0,0"
                                ToolTip="Processes with a Medium or High finding"
                                Visibility="{Binding Processes.AlertCount, Converter={StaticResource ToVisibility}}">
                            <TextBlock Text="{Binding Processes.AlertCount}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusHotBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:ProcessesView DataContext="{Binding Processes}" />
            </TabItem>
            <TabItem AutomationProperties.Name="Network">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" TextElement.FontFamily="{StaticResource MonoFont}"
                                TextElement.FontSize="13" TextElement.FontWeight="Medium">
                        <TextBlock Text="Network" />
                        <Border Style="{StaticResource Pill}" Background="{StaticResource DangerSoftBrush}"
                                BorderBrush="{StaticResource DangerBorderBrush}" Margin="8,0,0,0"
                                ToolTip="Programs with a Medium or High network finding"
                                Visibility="{Binding Network.AlertCount, Converter={StaticResource ToVisibility}}">
                            <TextBlock Text="{Binding Network.AlertCount}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusHotBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:NetworkView DataContext="{Binding Network}" />
            </TabItem>
            <TabItem AutomationProperties.Name="Startup">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" TextElement.FontFamily="{StaticResource MonoFont}"
                                TextElement.FontSize="13" TextElement.FontWeight="Medium">
                        <TextBlock Text="Startup" />
                        <Border Style="{StaticResource Pill}" Background="{StaticResource DangerSoftBrush}"
                                BorderBrush="{StaticResource DangerBorderBrush}" Margin="8,0,0,0"
                                ToolTip="Startup entries with a Medium or High finding"
                                Visibility="{Binding Startup.AlertCount, Converter={StaticResource ToVisibility}}">
                            <TextBlock Text="{Binding Startup.AlertCount}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusHotBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:StartupView DataContext="{Binding Startup}" />
            </TabItem>
            <TabItem AutomationProperties.Name="Security">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" TextElement.FontFamily="{StaticResource MonoFont}"
                                TextElement.FontSize="13" TextElement.FontWeight="Medium">
                        <TextBlock Text="Security" />
                        <Border Style="{StaticResource Pill}" Background="{StaticResource DangerSoftBrush}"
                                BorderBrush="{StaticResource DangerBorderBrush}" Margin="8,0,0,0"
                                ToolTip="Antivirus problems, recent Defender detections and detected files"
                                Visibility="{Binding Security.AlertCount, Converter={StaticResource ToVisibility}}">
                            <TextBlock Text="{Binding Security.AlertCount}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusHotBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:SecurityView DataContext="{Binding Security}" />
            </TabItem>
            <TabItem Header="Alerts">
                <views:AlertsView DataContext="{Binding Alerts}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
