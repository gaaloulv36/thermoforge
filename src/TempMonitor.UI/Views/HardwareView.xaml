<UserControl x:Class="TempMonitor.UI.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TempMonitor.UI.ViewModels"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HardwareViewModel}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:SummaryCardViewModel}">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,2"
                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                    <TextBlock Text="{Binding Source}" Style="{StaticResource SecondaryText}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Sorted rather than grouped: DataGrid grouping collapses every column to its minimum width. -->
        <CollectionViewSource x:Key="SortedSensors" Source="{Binding Sensors}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Hardware" />
                <scm:SortDescription PropertyName="Order" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding StatusText}" HorizontalAlignment="Right" Margin="0,0,0,8"
                   Style="{StaticResource SecondaryText}" />

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="6" Rows="1" Margin="0,0,-10,14">
            <ContentControl Content="{Binding CpuTemperature}" />
            <ContentControl Content="{Binding CpuLoad}" />
            <ContentControl Content="{Binding GpuTemperature}" />
            <ContentControl Content="{Binding GpuLoad}" />
            <ContentControl Content="{Binding StorageTemperature}" />
            <ContentControl Content="{Binding Fan}" />
        </UniformGrid>

        <!-- Temperature history -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="6" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="8,4,0,0" Style="{StaticResource SecondaryText}"
                           Text="Temperature history · last 10 minutes · tick sensors in the table to chart them" />
                <scottplot:WpfPlot x:Name="TemperatureChart" />
            </DockPanel>
        </Border>

        <!-- All sensors -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource DarkDataGrid}" ItemsSource="{Binding Source={StaticResource SortedSensors}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Chart" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsCharted, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding IsChartable, Converter={StaticResource BoolToVisibility}}"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Device" Binding="{Binding Hardware}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Value" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
